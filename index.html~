<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Κανονική Ἀποτείχιση — Ἱερὸς Ναὸς Ἁγίων Πάντων Πατρῶν</title>
<meta name="description" content="Ἐπίσημη δήλωση κανονικῆς ἀποτειχίσεως τοῦ π. Νικολάου Δημαρᾶ καὶ τοῦ Ἱεροῦ Ναοῦ Ἁγίων Πάντων Πατρῶν ἀπὸ τὴν Ἐκκλησία Γ.Ο.Χ. Ἑλλάδος.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cardo:ital@0;1&family=Cinzel:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #2a2420;
    --ink-soft: #4a3f36;
    --paper: #faf6ee;
    --paper-panel: #fffdf8;
    --rule: #c9a24b;
    --rule-soft: #e4d4a8;
    --accent: #7a1f1f;
    --accent-dark: #591414;
    --shadow: rgba(60, 40, 10, 0.12);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ink: #ece4d6;
      --ink-soft: #cfc3ae;
      --paper: #1b1712;
      --paper-panel: #241f18;
      --rule: #c9a24b;
      --rule-soft: #4a3f2a;
      --accent: #e2a15c;
      --accent-dark: #d99a4e;
      --shadow: rgba(0, 0, 0, 0.4);
    }
  }
  :root[data-theme="dark"] {
    --ink: #ece4d6;
    --ink-soft: #cfc3ae;
    --paper: #1b1712;
    --paper-panel: #241f18;
    --rule: #c9a24b;
    --rule-soft: #4a3f2a;
    --accent: #e2a15c;
    --accent-dark: #d99a4e;
    --shadow: rgba(0, 0, 0, 0.4);
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--paper);
    color: var(--ink);
  }

  body {
    font-family: 'Cardo', 'Times New Roman', serif;
    font-size: 19px;
    line-height: 1.75;
    padding: 0 16px 64px;
  }

  .hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 16px 0;
    text-align: center;
  }
  .hero svg {
    width: 220px;
    height: auto;
    color: var(--accent);
  }

  .divider {
    height: 14px;
    max-width: 340px;
    margin: 26px auto;
    background-image:
      linear-gradient(135deg, var(--rule) 25%, transparent 25%),
      linear-gradient(225deg, var(--rule) 25%, transparent 25%);
    background-position: 0 0, 0 0;
    background-size: 14px 14px;
    background-repeat: repeat-x;
    opacity: 0.75;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  header {
    max-width: 760px;
    margin: 8px auto 0;
    text-align: center;
  }

  .kicker {
    font-family: 'Cinzel', serif;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--accent);
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  h1 {
    font-family: 'Cardo', serif;
    font-weight: 700;
    font-size: clamp(28px, 5.5vw, 42px);
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 14px;
  }

  .parish {
    font-size: 16px;
    color: var(--ink-soft);
    margin: 0 0 4px;
  }

  .address {
    font-size: 14px;
    color: var(--ink-soft);
    margin: 0 0 28px;
  }

  main {
    max-width: 760px;
    margin: 0 auto;
  }

  .doc-panel {
    background: var(--paper-panel);
    border: 1px solid var(--rule-soft);
    border-radius: 4px;
    padding: 36px 40px;
    box-shadow: 0 10px 30px var(--shadow);
  }

  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    font-family: 'Cinzel', serif;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--accent-dark);
    text-transform: uppercase;
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--rule-soft);
  }

  .salutation {
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 6px;
  }

  .recipient {
    margin: 0 0 26px;
  }
  .recipient strong { color: var(--ink); }

  .drop-cap::first-letter {
    font-family: 'Cinzel', serif;
    font-size: 3.1em;
    float: left;
    line-height: 0.85;
    padding: 0.03em 0.08em 0 0;
    color: var(--accent);
  }

  p { margin: 0 0 20px; text-align: justify; hyphens: auto; }

  .declaration {
    background: rgba(122, 31, 31, 0.06);
    border-left: 3px solid var(--accent);
    padding: 18px 22px;
    margin: 26px 0 30px;
    font-weight: 600;
  }
  :root[data-theme="dark"] .declaration,
  @media (prefers-color-scheme: dark) { .declaration { background: rgba(226, 161, 92, 0.08); } }

  .canons {
    font-size: 15px;
    color: var(--ink-soft);
  }

  h2.section {
    font-family: 'Cinzel', serif;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-dark);
    border-bottom: 1px solid var(--rule-soft);
    padding-bottom: 8px;
    margin: 40px 0 20px;
  }

  ul.reasons {
    padding-left: 0;
    list-style: none;
    margin: 0 0 20px;
  }
  ul.reasons li {
    position: relative;
    padding-left: 28px;
    margin-bottom: 16px;
    text-align: justify;
  }
  ul.reasons li::before {
    content: "✕";
    position: absolute;
    left: 0; top: 2px;
    color: var(--accent);
    font-size: 14px;
  }

  .signature {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--rule-soft);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 22px;
    text-align: right;
  }
  .seal {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    color: var(--accent);
    opacity: 0.9;
  }
  .signature .place-date {
    font-size: 15px;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
  .signature .names {
    font-weight: 700;
    font-size: 18px;
  }
  .signature .title2 {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .attachment {
    max-width: 760px;
    margin: 36px auto 0;
    text-align: center;
  }
  .attachment h2 {
    margin: 0 0 10px;
    color: var(--ink);
    font-family: 'Cardo', serif;
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.3;
  }
  .attachment > p {
    max-width: 640px;
    margin: 0 auto 22px;
    color: var(--ink-soft);
    font-size: 16px;
    text-align: center;
  }
  .attachment-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .attachment .attachment-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Cinzel', serif;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper-panel);
    background: var(--accent);
    padding: 14px 28px;
    border-radius: 3px;
    transition: background 0.15s ease;
  }
  .attachment .attachment-link:hover { background: var(--accent-dark); }
  .attachment .attachment-link.secondary {
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent-dark);
  }
  .attachment .attachment-link.secondary:hover {
    background: rgba(122, 31, 31, 0.08);
  }

  .page-index {
    margin-top: 26px;
    padding: 22px;
    border: 1px solid var(--rule-soft);
    border-radius: 4px;
    background: var(--paper-panel);
    box-shadow: 0 8px 24px var(--shadow);
  }
  .page-index-title {
    display: block;
    margin-bottom: 14px;
    color: var(--accent-dark);
    font-family: 'Cinzel', serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .page-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(42px, 1fr));
    gap: 7px;
  }
  .page-links a {
    display: flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule-soft);
    border-radius: 3px;
    color: var(--accent-dark);
    font-family: 'Cinzel', serif;
    font-size: 12px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .page-links a:hover {
    border-color: var(--rule);
    background: rgba(201, 162, 75, 0.12);
  }

  footer {
    max-width: 760px;
    margin: 50px auto 0;
    text-align: center;
    font-size: 13px;
    color: var(--ink-soft);
  }

  @media (max-width: 600px) {
    .doc-panel { padding: 26px 20px; }
    body { font-size: 17px; }
    .signature { flex-direction: column-reverse; text-align: center; }
    .hero svg { width: 160px; }
    .attachment-actions { align-items: stretch; flex-direction: column; }
    .attachment .attachment-link { justify-content: center; }
    .page-index { padding: 16px 12px; }
  }

  @media print {
    body { background: #fff; color: #000; }
    .doc-panel { box-shadow: none; border: none; }
    .attachment { display: none; }
  }
</style>
</head>
